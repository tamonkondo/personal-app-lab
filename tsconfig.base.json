{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "ignoreDeprecations": "6.0",
    "paths": {
      "@repo/ui": ["./packages/ui/index.ts"],
      "@repo/icons": ["./packages/ui/icons/index.ts"],
      "@repo/ui/*": ["./packages/ui/*"],
      "@repo/types": ["./packages/types/index.ts"],
      "@repo/types/*": ["./packages/types/*"],
      "@repo/schemas": ["./packages/schemas/index.ts"],
      "@repo/schemas/*": ["./packages/schemas/*"],
      "@repo/utils": ["./packages/utils/index.ts"],
      "@repo/utils/*": ["./packages/utils/*"]
    }
  }
}
