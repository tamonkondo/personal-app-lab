{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev:portal": "pnpm --filter @repo/portal dev",
    "dev:nta": "pnpm --filter @repo/notion-training-app dev",
    "dev:ntpa": "pnpm --filter @repo/notion-todo-pomodoro-app dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "build:portal": "pnpm --filter @repo/portal build",
    "build:nta": "pnpm --filter @repo/notion-training-app build",
    "build:ntpa": "pnpm --filter @repo/notion-todo-pomodoro-app build",
    "build:api": "pnpm --filter @repo/api build",
    "build": "pnpm -r build",
    "add:ui": "tsx ./scripts/add-ui.ts",
    "typecheck": "pnpm -r typecheck",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev:build": "docker compose -f compose.yml -f compose.dev.yml build",
    "docker:dev:up": "docker compose -f compose.yml -f compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f compose.yml -f compose.dev.yml down",
    "docker:dev:logs": "docker compose -f compose.yml -f compose.dev.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.22.4",
    "typescript": "catalog:"
  }
}
