{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "dev:app": "pnpm --filter @repo/personal-app dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "build:app": "pnpm --filter @repo/personal-app build",
    "build:api": "pnpm --filter @repo/api build",
    "build": "pnpm -r build",
    "add:ui": "tsx ./scripts/add-ui.ts",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:dev:build": "docker compose -f compose.yml -f compose.dev.yml build",
    "docker:dev:up": "docker compose -f compose.yml -f compose.dev.yml up -d",
    "docker:dev:down": "docker compose -f compose.yml -f compose.dev.yml down",
    "docker:dev:logs": "docker compose -f compose.yml -f compose.dev.yml logs -f"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "tsx": "^4.23.4",
    "typescript": "catalog:"
  }
}
