{
  "name": "portfolio-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev:portal": "pnpm --filter @repo/portal dev",
    "dev:app1": "pnpm --filter @repo/app1 dev",
    "dev:app2": "pnpm --filter @repo/app2 dev",
    "dev:api": "pnpm --filter @repo/api dev",
    "build:portal": "pnpm --filter @repo/portal build",
    "build:app1": "pnpm --filter @repo/app1 build",
    "build:app2": "pnpm --filter @repo/app2 build",
    "build:api": "pnpm --filter @repo/api build",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck"
  },
  "devDependencies": {
    "typescript": "latest"
  }
}
